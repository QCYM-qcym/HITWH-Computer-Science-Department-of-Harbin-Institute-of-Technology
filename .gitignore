# 默认只发布明确分区中的文件，原始资料继续在本地保存。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/docs/
!/src/
!/tests/
!/configs/
!/experiments/
!/data/
!/tools/
!/.github/
!/.githooks/

**/__pycache__/
**/node_modules/
**/.venv/
**/.env
**/.env.*
!**/.env.example
**/*local*
**/~$*
**/*.log
**/*.tmp
**/*.bak
data/raw/*
data/processed/*
experiments/runs/*
!**/README.md
# 排版文件、图片和模型需经过专门审查，初次入库使用可审阅文本。
*.docx
*.pptx
*.pdf
*.png
*.jpg
*.jpeg
*.vsdx
*.zip
*.pt
*.pth
*.pkl
*.parquet
*.csv
*.npy

